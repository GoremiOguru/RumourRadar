# Rumour Radar Environment Variables
# Copy this file to .env.local and fill in your keys

# OpenRouter Unified AI API Key (Free tier available at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Google Fact Check Tools API Key (Optional)
GOOGLE_FACT_CHECK_API_KEY=

# Supabase (Optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
